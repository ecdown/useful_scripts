#!/bin/sh
#############################################################
#
#  Name: ffind
#  Description: Find file or directories containing the 
#               search term
#
#  Author: Eric Downing <ecdown@etechtips.com>
#
#  Version: 1.4
#  v1.4: added maxdepth
#############################################################

## Print Usage
usage_example() {
  echo 1>&2 Usage: $0 ""
  echo "Find files with matching name"
  echo "Arguments:"
  echo "  -i ignore case"
  echo "  -m <num> max directory depth"
  echo "  -d search directory names only"
  echo "  -f search file names only"
  exit 127
}

## If no arguments, display usage
if [ $# -lt 1 ]; then
  usage_example
fi
icase=

# Handle Args
while [ $# -ge 1 ]; do
   case $1 in
     --help) usage_example; exit 127 ;;
     -i)  icase=$1;;
     -m)  depthval="-maxdepth $2"
	  shift;;
     -d)  typeent="-type d";;
     -f)  typeent="-type f";;
      *)  search=$1 ;;
   esac
   shift
done

# if no search term given print error and exit
if [ -z "$search" ]; then
  echo "Error: No Search term specified" 
  exit 127
fi

# Execute search with given args
find . $depthval $typeent | grep $icase $search

