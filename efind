#!/bin/sh
##################################################
# Script: efind
# Description: Search for term in all files
# Author: Eric Downing <ecdown@etechtips.com>
# Version: 1.1
# v1.1: add maxdepth
##################################################
if [ $# -lt 1 ]; then
  echo 1>&2 Usage: $0 ""
  echo "Find files with matching pattern"
  echo "Arguments:"
  echo "   -c filename with match counts"
  echo "   -m <num> max directory depth"
  echo "   -i ignore case"
  echo "   --color color search term in results"
  echo "   -l file matches only"
  exit 127
fi
icase=
search=

while [ $# -ge 1 ]; do
  case $1 in
     -i) icase=$1;;
     -c) counts=$1;;
     -m)  depthval="-maxdepth $2"
	  shift;;
     --color) colorsearch="--color=always";;
      *) search=$1 ;;
  esac
  shift
done
echo Searching
find . $depthval -type f -print0 | xargs -0 grep $counts $icase $search $colorsearch
